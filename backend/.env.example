# ─────────────────────────────────────────────────────────────────────────────
# TaskFlow backend — copy this file to .env and fill in real values.
#   cp .env.example .env
# Never commit your .env file (it is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/taskflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/taskflow
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# JWT secrets — generate each one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL(s) used for CORS and email links.
# Comma-separate multiple origins, e.g. "http://localhost:5173,https://taskflow.example.com"
CLIENT_URL=http://localhost:5173

# Email (SMTP) — leave blank to use development mode (links are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@taskflow.dev
