# Frontend environment
#
# Leave VITE_API_URL unset in development: the Vite dev server proxies /api to
# the Express backend (see vite.config.js) and production is served behind the
# same origin by nginx. Only set it when the API lives on another origin, e.g.
#   VITE_API_URL=https://api.taskflow.example.com/api

# VITE_API_URL=/api
